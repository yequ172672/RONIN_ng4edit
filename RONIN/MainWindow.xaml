<Window x:Class="RONIN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:RONIN.Preview"
        xmlns:local="clr-namespace:RONIN"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="RONIN" Height="720" Width="1280">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type preview:TexturePreviewViewModel}"
                  xmlns:local="clr-namespace:RONIN.Preview">
            <StackPanel>
                <Image Source="{Binding Image}" Stretch="Uniform"/>
                <TextBlock Text="{Binding Width, StringFormat=Texture: {0}px}" Margin="8,6,8,0" Foreground="White"/>
                <TextBlock Text="{Binding Height, StringFormat=Height: {0}px}" Margin="8,2,8,0" Foreground="White"/>
                <TextBlock Text="{Binding MipCount, StringFormat=Mips: {0}}" Margin="8,2,8,8" Foreground="White"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:AtlasTexturePreviewViewModel}">
            <Image Source="{Binding Image}" Stretch="Uniform"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:AnimationPreviewViewModel}">
            <Image Source="{Binding Image}" Stretch="Uniform"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:FontPreviewViewModel}">
            <Image Source="{Binding Image}" Stretch="Uniform"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:ModelPreviewViewModel}">
            <TabControl>
                <TabItem Header="Viewport">
                    <hx:Viewport3DX x:Name="viewport"
                        EffectsManager="{Binding EffectsManager}"
                        Camera="{Binding Camera}"
                        ZoomExtentsWhenLoaded="True"
                            Background="#202020">

                        <hx:AmbientLight3D Color="White"/>
                        <hx:DirectionalLight3D Direction="-1,-1,-1" Color="White"/>

                        <hx:ItemsModel3D ItemsSource="{Binding Models}"/>

                    </hx:Viewport3DX>
                </TabItem>
                <TabItem Header="Model Info">
                    
                </TabItem>
                
            </TabControl>
            

        </DataTemplate>
        <DataTemplate DataType="{x:Type preview:AssetTablePreviewViewModel}">
            <ListView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding Entries}"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Recycling"
         ScrollViewer.CanContentScroll="True"
                      SelectionChanged="AssetTableList_SelectionChanged"
                              Name="AssetTableList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="290" DisplayMemberBinding="{Binding TableName}"/>
                        <GridViewColumn Header="UUID" Width="290"  DisplayMemberBinding="{Binding UUIDString}"></GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

        </DataTemplate>
        
    </Window.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Menu>
                <MenuItem Header="File">
                    <MenuItem Header="Load AssetDatabase" Command="{Binding LoadAssetDatabaseCommand}"></MenuItem>
                </MenuItem>
                <MenuItem Header="Modding Tools" x:Name="ModdingToolsMenu">
                    <MenuItem Header="Export Selected Subfile"/>
                    <MenuItem Header="Export Selected Package" IsEnabled="{Binding HasSelectedEntry}" Command="{Binding ExportRaw}"/>
                    <MenuItem Header="Export Selected Package as FBX" IsEnabled="{Binding HasSelectedEntry}" Command="{Binding ExportAsFbxCommand}"/>
                    <MenuItem Header="Export Model as GLB" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ExportAsGltfCommand}"/>
                    <MenuItem Header="Export Model Workspace (GLB + TGA)" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ExportModelWorkspaceCommand}"/>
                    <MenuItem Header="Export Model Texture Set (PNG)" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ExportModelTextureSetPngCommand}"/>
                    <MenuItem Header="Export Model Texture Set (TGA)" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ExportModelTextureSetTgaCommand}"/>
                    <MenuItem Header="Package .ng4mod from Workspace GLB" Command="{Binding PackageNg4ModCommand}"/>
                    <MenuItem Header="Export Selected Package as DDS" IsEnabled="{Binding IsTextureModdingEnabled}" Command="{Binding ExportTextureAsDdsCommand}"/>
                    <Separator></Separator>
                    <MenuItem Header="Replace Selected Subfile"/>
                    <MenuItem Header="Replace Selected Package (BETA)"/>
                    <MenuItem Header="Replace With Conversion">
                        <MenuItem Header="Replace Selected Package with .DDS" IsEnabled="{Binding IsTextureModdingEnabled}" Command="{Binding ReplaceSelectedPackageWithDdsCommand}"/>
                        <MenuItem Header="Replace Selected Package with .FBX" IsEnabled="{Binding HasSelectedEntry}" Command="{Binding ReplaceWithFbxCommand}"/>
                        <MenuItem Header="Replace Model from GLB" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ReplaceWithGlbCommand}"/>
                        <MenuItem Header="Import Model Texture Set (PNG/TGA Folder)" IsEnabled="{Binding IsModelModdingEnabled}" Command="{Binding ImportModelTextureSetCommand}"/>
                    </MenuItem>
                    <Separator></Separator>
                    <MenuItem Header="Generate Patch (.csv/.dat)" IsEnabled="{Binding HasStagedChanges}" Command="{Binding GeneratePatchCommand}"/>
                    <MenuItem Header="Patch Generator Settings" Command="{Binding OpenPatchGeneratorSettingsCommand}">
                        <CheckBox IsEnabled="False">Compress Data?</CheckBox>
                    </MenuItem>
                    
                </MenuItem>
                <MenuItem Header="Back" IsEnabled="{Binding HasBackEntry}" Command="{Binding GoBackToPreviousEntry}"/>

            </Menu>


        </ToolBar>


        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalContentAlignment="Stretch"
                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="16" Margin="2"
                                 Minimum="0" Maximum="{Binding ProgressTotal}"
                                 Value="{Binding ProgressCurrent}"
                                 IsIndeterminate="{Binding IsBusy}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="400"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition> <!-- Content Drawer-->
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" FontWeight="Bold">Changed Files List</Label>
                    <TextBlock Grid.Row="0" Text="{Binding ModifiedAssets.Count, StringFormat={} ({0} staged)}" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding ModifiedAssets}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Pending Change" Width="180" DisplayMemberBinding="{Binding ParentEntry.Path}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
                <Border Grid.Column="1" Background="#111111">
                    <ContentControl Content="{Binding PreviewContent}"/>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" FontWeight="Bold">Package Properties</Label>
                        <Label Grid.Row="1" Content="{Binding SelectedEntry.FileName}"></Label>
                        <Label Grid.Row="2" Content="{Binding SelectedEntry.Type}"></Label>
                        <Label Grid.Row="3" Content="{Binding SelectedEntry.CmpSizeFormatted}"></Label>
                        <Label Grid.Row="4" Content="{Binding SelectedEntry.SizeFormatted}"></Label>
                        <Label Grid.Row="5" Content="{Binding SelectedEntry.SourceArchive}"></Label>
                        
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label FontWeight="Bold">Subfiles</Label>
                        <ListView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding SelectedEntry.SubEntries}"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Recycling"
         ScrollViewer.CanContentScroll="True"
                              Name="SubfileList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn x:Name="SubfileNameColumn" Width="170" Header="Subfile Name" DisplayMemberBinding="{Binding FileName}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                    </Grid>
                    

                </Grid>
                
                

            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TreeView Grid.Column="0" ItemsSource="{Binding RootFolders}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <EventSetter Event="Selected" Handler="TreeViewItem_Selected"></EventSetter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Content="{Binding ActivePath}" FontStyle="Italic"></Label>

                    <ListView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding DebugAssets}"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Recycling"
         ScrollViewer.CanContentScroll="True"
                              SizeChanged="ListView_SizeChanged"
                              SelectionChanged="FileList_Selected"
                              Name="FileList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="FileNameColumn" Header="Package Name" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="File Count" Width="70" DisplayMemberBinding="{Binding SubEntries.Count}"/>
                                <GridViewColumn Header="Compressed Size" Width="100" DisplayMemberBinding="{Binding CmpSizeFormatted}"/>
                                <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeFormatted}"/>
                                <GridViewColumn Header="Archive" Width="100" DisplayMemberBinding="{Binding SourceArchive}"/>
                                <GridViewColumn Header="UUID" Width="290"  DisplayMemberBinding="{Binding StringAssetID}"></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>


                </Grid>
                
                


            </Grid>
            





        </Grid>

    </DockPanel>
</Window>
