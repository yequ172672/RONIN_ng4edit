<Window x:Class="RONIN.ModdingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch Generator Settings"
        Height="260"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configure patch generation settings"
                   FontWeight="Bold"
                   FontSize="16"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Game directory:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox Grid.Column="1"
                     x:Name="GamePathTextBox"
                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Browse..."
                    Width="80"
                    Click="Browse_Click"/>
        </Grid>

        <CheckBox Grid.Row="2"
                  x:Name="CompressCheckBox"
                  Content="Compress data in patch .dat"
                  IsChecked="{Binding CompressData}"
                  Margin="0,0,0,10"/>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Staged changes:" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBlock x:Name="StagedCountText" Grid.Column="1" Text="{Binding StagedChangeCount, StringFormat={}{0} pending replacement(s)}"/>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="#888"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Background="#111111">
            <StackPanel>
                <TextBlock Text="Patch status" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="PatchCommitText" Text="{Binding PatchCommitStatus}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="BackupSnapshotText" Text="{Binding BackupSnapshotStatus}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="VerificationText" Text="{Binding VerificationStatus}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#BFD7FF" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Generate Patch"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="GeneratePatch_Click"/>
            <Button Content="OK"
                    Width="80"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="Ok_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
